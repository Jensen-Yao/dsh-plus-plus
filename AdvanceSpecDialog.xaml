<Window x:Class="DshControl.AdvanceSpecDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="升级到远端最新" Width="560" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BgAppBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Icon="dsh-control.ico">
    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptText" Style="{StaticResource TbBody}" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <RadioButton x:Name="RangeRadio" GroupName="AdvanceSpec" Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <RadioButton x:Name="PinRadio" GroupName="AdvanceSpec" Foreground="{DynamicResource TextPrimaryBrush}"/>
        </StackPanel>
        <TextBlock x:Name="NoteText" Grid.Row="2" Style="{StaticResource TbHint}" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button x:Name="BtnOk" Content="继续" Style="{StaticResource BtnPrimary}"
                    Width="88" Margin="0,12,8,0" Click="BtnOk_Click"/>
            <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource BtnSecondary}"
                    Width="88" Margin="0,12,0,0" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
