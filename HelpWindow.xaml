<Window x:Class="DshControl.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="使用说明" Width="740" Height="660" MinWidth="640" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgAppBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Icon="dsh-control.ico">
    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="使用说明" Style="{StaticResource TbTitle}" Margin="0,0,0,2"/>
        <TextBlock Text="网络互联 · Tailscale · 公网隧道 · 存储位置"
                   Style="{StaticResource TbSub}" Margin="0,0,0,12"/>
        <TabControl x:Name="Tabs" Grid.Row="1"/>
    </Grid>
</Window>
