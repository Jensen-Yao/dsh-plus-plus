<Window x:Class="DshControl.UpdatePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认维护" Width="700" Height="480" MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BgAppBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13">
    <Grid Background="{DynamicResource BgAppBrush}"><Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="PreviewTitle" Style="{StaticResource SectionTitle}"/>
        <TextBlock x:Name="ImpactText" Grid.Row="1" Style="{StaticResource TbHint}" TextWrapping="Wrap" Margin="0,12,0,18"/>
        <ListBox x:Name="ChangeList" Grid.Row="2" Background="{DynamicResource BgAppBrush}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,8,0,12">
                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Versions}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" IsCancel="True" Style="{StaticResource BtnGhost}" Margin="0,0,8,0"/>
            <Button Content="开始维护" IsDefault="True" Style="{StaticResource BtnPrimary}" Click="Confirm_Click"/>
        </StackPanel>
    </Grid></Grid>
</Window>
